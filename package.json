{
  "name": "dsh-freellmapi",
  "version": "1.2.6",
  "type": "module",
  "description": "FreeLLMAPI as a first-class model provider in DeepSeek Harness: the free-model router ships inside the plugin (no Docker, no checkout), with a sidebar panel to start it, probe which models really answer, and rank them by the router's own scores. 把 FreeLLMAPI 做成 DeepSeek Harness 的一等模型 provider，路由本体随插件打包。",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "freellmapi",
    "llm-adapter",
    "free-models",
    "free-llm",
    "model-provider",
    "router",
    "fallback",
    "openai-compatible",
    "deepseek",
    "插件",
    "免费模型",
    "模型接入"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stallenlu/dsh-freellmapi.git"
  },
  "homepage": "https://github.com/stallenlu/dsh-freellmapi#readme",
  "bugs": {
    "url": "https://github.com/stallenlu/dsh-freellmapi/issues"
  },
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "icon.svg",
    "lib/index.js",
    "lib/client.js",
    "lib/adapter.js",
    "lib/chat.js",
    "lib/stream.js",
    "lib/supervisor.js",
    "lib/runtime.js",
    "lib/store.js",
    "lib/probe.js",
    "lib/ranking.js",
    "lib/kernel.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "smoke.mjs",
    "vendor/"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "license": "MIT"
}
